# Application
NODE_ENV=development

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://fraggit:fraggit@localhost:5432/fraggit?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=14d

# SMTP (optional — without it emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fraggit <no-reply@fraggit.local>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
