# Application
NODE_ENV=development

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://fraggit:fraggit@localhost:5432/fraggit?schema=public

# Redis (local: HOST/PORT; Railway: set REDIS_URL from Redis service)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=14d

# SMTP (optional — without it emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fraggit <no-reply@fraggit.local>

# Mail queue (BullMQ)
MAIL_QUEUE_ATTEMPTS=5
MAIL_QUEUE_RETRY_DELAY_MS=60000

# Telegram bot (optional — without it linking/notifications are disabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=fraggitbot
TELEGRAM_LINK_CODE_TTL_SECONDS=600

# Google OAuth (optional — without it Google sign-in is disabled)
# Use the frontend origin so cookies are set on the same host as /api rewrites.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
