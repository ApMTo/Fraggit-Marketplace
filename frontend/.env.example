NEXT_PUBLIC_API_URL=/api
# Public site origin for Open Graph / absolute URLs (optional on Vercel — VERCEL_URL is used)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Socket.IO connects directly to the Nest backend. Auth uses /api/auth/ws-token
# (same-origin cookies via Vercel rewrite) then handshake.auth.token.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001
