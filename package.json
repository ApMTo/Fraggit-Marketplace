{
  "name": "fraggit",
  "version": "1.0.0",
  "private": true,
  "description": "Fraggit marketplace monorepo",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:backend": "pnpm --filter @fraggit/backend dev",
    "dev:frontend": "pnpm --filter @fraggit/frontend dev",
    "build": "pnpm run --recursive build",
    "build:backend": "pnpm --filter @fraggit/backend build",
    "build:frontend": "pnpm --filter @fraggit/frontend build",
    "lint": "pnpm run --recursive lint"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
