generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  username    String  @unique
  displayName String
  avatarUrl   String?
  bio         String?

  role   UserRole   @default(USER)
  status UserStatus @default(PENDING_VERIFICATION)

  rating          Float @default(0)
  ratingCount     Int   @default(0)
  successfulSales Int   @default(0)

  twoFactorEnabled Boolean @default(false)
  emailVerified    Boolean @default(false)

  telegramId       String?
  telegramUsername String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lots         Lot[]
  buyerOrders  Order[] @relation("BuyerOrders")
  sellerOrders Order[] @relation("SellerOrders")
}

enum AttributeType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories       Subcategory[]
  lots                Lot[]
  attributeDefinitions AttributeDefinition[]
}

model Subcategory {
  id String @id @default(uuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name String
  slug String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes AttributeDefinition[]
  globalAttributeLinks SubcategoryGlobalAttribute[]
  lots                 Lot[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model AttributeDefinition {
  id String @id @default(uuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  isGlobal Boolean @default(false)

  key   String
  label String

  type AttributeType

  required Boolean @default(false)

  options Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values LotAttributeValue[]

  subcategoryLinks SubcategoryGlobalAttribute[]

  @@index([categoryId])
  @@index([categoryId, isGlobal])
  @@index([subcategoryId])
  @@index([subcategoryId, sortOrder])
}

model SubcategoryGlobalAttribute {
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  attributeDefinitionId String
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@id([subcategoryId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

enum LotStatus {
  OPEN
  CLOSED
  ARCHIVED
}

model Lot {
  id String @id @default(uuid())

  title String

  description String? @db.Text

  price Decimal @db.Decimal(12, 2)

  stock Int @default(1)

  status LotStatus @default(OPEN)

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])

  attributes LotAttributeValue[]
  images     LotImage[]
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([price])
  @@index([createdAt])
}

model LotAttributeValue {
  id String @id @default(uuid())

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  value String

  @@unique([lotId, attributeId])
  @@index([lotId])
  @@index([attributeId])
  @@index([attributeId, value])
}

model LotImage {
  id String @id @default(uuid())

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@index([lotId])
}

enum OrderStatus {
  PENDING
  AWAITING_BUYER_CONFIRMATION
  APPROVED
}

model Order {
  id String @id @default(uuid())

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])

  price Decimal @db.Decimal(12, 2)

  status OrderStatus @default(PENDING)

  credentials            String?   @db.Text
  credentialsProvidedAt  DateTime?
  autoApproveAt          DateTime?
  approvedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([autoApproveAt])
  @@index([createdAt])
}
