generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  username    String  @unique
  displayName String
  avatarUrl   String?
  bio         String?

  role   UserRole   @default(USER)
  status UserStatus @default(PENDING_VERIFICATION)

  /// Soft timed suspend; staff clears manually (no auto-expiry cron in MVP).
  suspendedUntil DateTime?

  rating          Float @default(0)
  ratingCount     Int   @default(0)
  successfulSales Int   @default(0)

  twoFactorEnabled Boolean @default(false)
  emailVerified    Boolean @default(false)

  emailChangedAt    DateTime?
  usernameChangedAt DateTime?

  telegramId       String?
  telegramUsername String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lots            Lot[]
  buyerOrders     Order[]  @relation("BuyerOrders")
  sellerOrders    Order[]  @relation("SellerOrders")
  reviewsWritten  Review[] @relation("ReviewsWritten")
  reviewsReceived Review[] @relation("ReviewsReceived")
  reviewsHidden   Review[] @relation("ReviewsHiddenBy")

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("SentMessages")
  notifications            Notification[]

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsAssigned Report[] @relation("ReportsAssigned")
  reportsResolved Report[] @relation("ReportsResolved")

  moderationActions ModerationAction[] @relation("ModerationActionsActor")

  ticketsFiled    Ticket[] @relation("TicketsFiled")
  ticketsAssigned Ticket[] @relation("TicketsAssigned")
  ticketMessages  TicketMessage[]

  lotDisputeMessages LotDisputeMessage[]
}

enum AttributeType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  iconUrl    String?
  previewUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories       Subcategory[]
  lots                Lot[]
  attributeDefinitions AttributeDefinition[]
}

model Subcategory {
  id String @id @default(uuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Localized display name: { "en": "Accounts", "ru": "Аккаунты" }. `en` is required.
  name Json
  slug String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes AttributeDefinition[]
  globalAttributeLinks SubcategoryGlobalAttribute[]
  lots                 Lot[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model AttributeDefinition {
  id String @id @default(uuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  isGlobal Boolean @default(false)

  key   String
  label String

  type AttributeType

  required Boolean @default(false)

  options Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values LotAttributeValue[]

  subcategoryLinks SubcategoryGlobalAttribute[]

  @@index([categoryId])
  @@index([categoryId, isGlobal])
  @@index([subcategoryId])
  @@index([subcategoryId, sortOrder])
}

model SubcategoryGlobalAttribute {
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  attributeDefinitionId String
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@id([subcategoryId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

enum LotStatus {
  OPEN
  CLOSED
  ARCHIVED
  REMOVED
  UNDER_REVIEW
}

enum LotType {
  ACCOUNT
  SERVICE
}

model Lot {
  id String @id @default(uuid())

  title String

  description String? @db.Text

  /// Cover image for browse/detail. Falls back to category.previewUrl when omitted on create.
  previewUrl String?

  /// ACCOUNT: seller delivers credentials. SERVICE: buyer answers questions, seller marks done.
  type LotType @default(ACCOUNT)

  /// Question(s) the buyer must answer when purchasing a SERVICE lot.
  serviceQuestion String? @db.Text

  price Decimal @db.Decimal(12, 2)

  stock Int @default(1)

  status LotStatus @default(OPEN)

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])

  attributes LotAttributeValue[]
  images     LotImage[]
  orders     Order[]
  disputeRooms LotDisputeRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([sellerId, status])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([price])
  @@index([createdAt])
}

model LotAttributeValue {
  id String @id @default(uuid())

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  value String

  @@unique([lotId, attributeId])
  @@index([lotId])
  @@index([attributeId])
  @@index([attributeId, value])
}

model LotImage {
  id String @id @default(uuid())

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@index([lotId])
}

enum OrderStatus {
  PENDING
  AWAITING_BUYER_CONFIRMATION
  /// Dispute opened — auto-approve timer paused until staff resolves.
  DISPUTED
  APPROVED
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])

  price Decimal @db.Decimal(12, 2)

  status OrderStatus @default(PENDING)

  /// Snapshot of lot.serviceQuestion at purchase time (SERVICE orders).
  serviceQuestion String? @db.Text

  /// Buyer's answer to the service question (SERVICE orders).
  buyerAnswer String? @db.Text

  credentials            String?   @db.Text
  credentialsProvidedAt  DateTime?
  autoApproveAt          DateTime?
  /// Status before DISPUTED (PENDING or AWAITING_BUYER_CONFIRMATION).
  disputePausedFromStatus OrderStatus?
  /// Remaining auto-approve window (ms) frozen when dispute opened.
  autoApproveRemainingMs  Int?
  approvedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  tickets Ticket[]

  disputeRooms LotDisputeRoom[]

  @@index([lotId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([autoApproveAt])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model Conversation {
  id String @id @default(uuid())

  pairKey String? @unique

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadMessageId String?
  lastReadMessage   Message?  @relation("ParticipantLastRead", fields: [lastReadMessageId], references: [id], onDelete: SetNull)
  lastReadAt        DateTime?

  hiddenAt DateTime?

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, conversationId])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  type MessageType

  content String? @db.Text

  metadata Json?

  createdAt DateTime @default(now())

  attachments              MessageAttachment[]
  lastReadByParticipants   ConversationParticipant[] @relation("ParticipantLastRead")

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model MessageAttachment {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url      String
  mimeType String
  size     Int
  width    Int?
  height   Int?

  createdAt DateTime @default(now())

  @@index([messageId])
}

model Review {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  reviewerId String
  reviewer   User @relation("ReviewsWritten", fields: [reviewerId], references: [id])

  revieweeId String
  reviewee   User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  rating Int
  text   String @db.Text

  hiddenAt   DateTime?
  hiddenById String?
  hiddenBy   User?     @relation("ReviewsHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([createdAt])
  @@index([hiddenAt])
}

enum ReportTargetType {
  USER
  LOT
  REVIEW
  MESSAGE
}

enum ReportReason {
  SPAM
  SCAM
  ABUSE
  STOLEN
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id String @id @default(uuid())

  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String

  reason  ReportReason
  details String?      @db.Text

  status ReportStatus @default(OPEN)

  assignedToId String?
  assignedTo   User?   @relation("ReportsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  resolutionNote String? @db.Text

  disputeRoom LotDisputeRoom?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reporterId, targetType, targetId, status])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
  @@index([assignedToId])
}

enum LotDisputeRoomStatus {
  OPEN
  CLOSED
}

enum LotDisputeMessageKind {
  TEXT
  SYSTEM
}

model LotDisputeRoom {
  id String @id @default(uuid())

  lotId String
  lot   Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  reportId String? @unique
  report   Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  status LotDisputeRoomStatus @default(OPEN)

  messages LotDisputeMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId, status])
  @@index([orderId, status])
}

model LotDisputeMessage {
  id String @id @default(uuid())

  roomId String
  room   LotDisputeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  authorId String?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  kind     LotDisputeMessageKind
  body     String                @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([authorId])
}

enum ModerationTargetType {
  USER
  LOT
  REVIEW
  REPORT
  TICKET
  CONVERSATION
}

enum ModerationActionType {
  USER_STATUS_CHANGE
  USER_ROLE_CHANGE
  USER_SESSIONS_REVOKE
  USER_2FA_RESET
  LOT_REMOVE
  LOT_RESTORE
  LOT_UNDER_REVIEW
  REVIEW_HIDE
  REVIEW_UNHIDE
  REPORT_ASSIGN
  REPORT_RESOLVE
  REPORT_DISMISS
  TICKET_CREATE
  TICKET_UPDATE
  TICKET_RESOLVE
  TICKET_MESSAGE
  CHAT_VIEW
}

model ModerationAction {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("ModerationActionsActor", fields: [actorId], references: [id], onDelete: Cascade)

  actionType ModerationActionType
  targetType ModerationTargetType
  targetId   String

  before   Json?
  after    Json?
  reason   String  @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([actionType, createdAt])
}

enum TicketType {
  ORDER_DISPUTE
  SUPPORT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum TicketResolution {
  NONE
  BUYER_FAVOR
  SELLER_FAVOR
  NO_ACTION
}

model Ticket {
  id String @id @default(uuid())

  type TicketType

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  reporterId String
  reporter   User   @relation("TicketsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  subject String
  body    String @db.Text

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  assigneeId String?
  assignee   User?   @relation("TicketsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Recorded decision only — payments/escrow side-effects come later.
  resolution     TicketResolution @default(NONE)
  resolutionNote String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  disputeRoom LotDisputeRoom?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([reporterId, createdAt])
  @@index([assigneeId])
}

model TicketMessage {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body       String  @db.Text
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CREDENTIALS
  ORDER_APPROVED
  TICKET_REPLY
  REPORT_STATUS
  TICKET_RESOLVED
  LOT_DISPUTE_MESSAGE
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  href  String?

  readAt DateTime?

  entityType String?
  entityId   String   @default("")
  metadata   Json?

  createdAt DateTime @default(now())

  @@unique([userId, type, entityId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([entityType, entityId])
}
